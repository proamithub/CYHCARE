@inherits LayoutComponentBase
@inject UserSessionService Session
@inject NavigationManager Navigation
@implements IDisposable

<div class="user-portal-layout d-flex flex-column min-vh-100 bg-light">
    <!-- Top Patient Portal Header -->
    <header class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top shadow-sm py-2 px-3 px-lg-4">
        <div class="container-fluid">
            <!-- Brand & Role Identifier -->
            <div class="d-flex align-items-center">
                <a class="navbar-brand d-flex align-items-center me-3 text-white" href="">
                    <i class="bi bi-heart-pulse-fill text-danger fs-3 me-2 pulse-heart"></i>
                    <span class="fw-bold fs-4">CYH <span class="text-white">Care</span></span>
                </a>
                <span class="badge bg-white text-primary fw-bold px-2 py-1 text-uppercase rounded-pill shadow-sm" style="font-size: 0.7rem;">
                    <i class="bi bi-person-heart me-1"></i> Patient & Family Portal
                </span>
            </div>

            <!-- Portal Navigation Links -->
            <div class="d-none d-md-flex align-items-center gap-3 ms-4">
                <NavLink class="nav-link text-white fw-medium px-2 py-1 rounded" href="user/dashboard" Match="NavLinkMatch.All">
                    <i class="bi bi-speedometer2 me-1"></i> My Dashboard
                </NavLink>
                <a class="nav-link text-white-50 hover-white px-2 py-1" href="#post-job-section">
                    <i class="bi bi-plus-circle me-1"></i> Post Request
                </a>
                <a class="nav-link text-white-50 hover-white px-2 py-1" href="#active-tracking">
                    <i class="bi bi-geo-alt me-1"></i> Live Companion
                </a>
            </div>

            <!-- User Status & Quick Actions -->
            <div class="d-flex align-items-center gap-2 ms-auto">
                <a href="" class="btn btn-sm btn-outline-light rounded-pill px-3 d-none d-sm-inline-block">
                    <i class="bi bi-house me-1"></i> Home
                </a>

                @if (Session.IsAuthenticated)
                {
                    <div class="dropdown">
                        <button class="btn btn-light btn-sm rounded-pill px-3 fw-medium d-flex align-items-center gap-2 shadow-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <span class="badge bg-primary text-white rounded-circle p-1"><i class="bi bi-person-fill"></i></span>
                            <span>@Session.FullName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li class="px-3 py-2 border-bottom">
                                <div class="fw-bold small text-dark">@Session.FullName</div>
                                <div class="text-muted small">@Session.Email</div>
                                <span class="badge bg-primary-subtle text-primary mt-1">Patient / Family</span>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="user/dashboard">
                                    <i class="bi bi-clipboard2-pulse me-2 text-primary"></i> My Care Requests
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <button class="dropdown-item py-2 text-danger" @onclick="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                </button>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="login" class="btn btn-light btn-sm rounded-pill px-3 fw-bold">Sign In</a>
                }
            </div>
        </div>
    </header>

    <!-- Sub-bar for Emergency support -->
    <div class="bg-primary-subtle border-bottom border-primary-subtle py-1 px-3 px-lg-4 text-center small text-primary-emphasis d-flex justify-content-between align-items-center">
        <span><i class="bi bi-shield-fill-check text-success me-1"></i> Every companion is Aadhaar & Police verified for hospital safety</span>
        <span class="d-none d-md-inline"><i class="bi bi-headset me-1"></i> Need help right now? Call <strong>1800-CYH-CARE</strong></span>
    </div>

    <!-- Main Content Area -->
    <main class="flex-grow-1 p-3 p-lg-4">
        <div class="container-fluid max-w-7xl">
            @Body
        </div>
    </main>

    <!-- Portal Footer -->
    <footer class="bg-white border-top py-3 px-4 text-center small text-muted mt-auto">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center">
            <span>&copy; 2026 CYH Care — Patient & Family Portal</span>
            <div class="mt-1 mt-sm-0">
                <a href="" class="text-decoration-none text-muted me-3">Public Home</a>
                <a href="how-it-works" class="text-decoration-none text-muted me-3">Hospital Companion Guide</a>
                <span class="text-success"><i class="bi bi-lock-fill"></i> Safe & Encrypted</span>
            </div>
        </div>
    </footer>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnAuthStateChanged += StateHasChanged;
    }

    private void Logout()
    {
        Session.ClearSession();
        Navigation.NavigateTo("/", forceLoad: false);
    }

    public void Dispose()
    {
        Session.OnAuthStateChanged -= StateHasChanged;
    }
}
