@using CYHCare.Web.Services
@inject UserSessionService Session
@inject NavigationManager Navigation
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-primary" href="">
            <i class="bi bi-heart-pulse-fill me-2 text-danger"></i>CYH Care
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill me-2"></i> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="user/dashboard">
                <i class="bi bi-person-workspace me-2"></i> User Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin">
                <i class="bi bi-shield-lock-fill me-2"></i> Admin Panel
            </NavLink>
        </div>

        <hr class="text-white-50 my-2 mx-3" />

        @if (Session.IsAuthenticated)
        {
            <div class="px-3 py-2 text-light small">
                <i class="bi bi-person-circle me-1"></i> @Session.FullName
                <span class="badge bg-secondary ms-1">@Session.Role</span>
            </div>
            <div class="nav-item px-3">
                <button class="btn btn-outline-danger btn-sm w-100 mt-1" @onclick="Logout">
                    <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                </button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="register">
                    <i class="bi bi-person-plus-fill me-2"></i> Register
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnAuthStateChanged += StateHasChanged;
    }

    private void Logout()
    {
        Session.ClearSession();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        Session.OnAuthStateChanged -= StateHasChanged;
    }
}
