@page "/helper/dashboard"
@rendermode InteractiveServer
@using CYHCare.Application.Common.Interfaces
@using CYHCare.Application.DTOs
@using CYHCare.Web.Services
@inject IHelperService HelperService
@inject IJobService JobService
@inject IPaymentRepository PaymentRepo
@inject UserSessionService Session
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Helper Companion Portal — CYH Care</PageTitle>

<div class="container py-4">
    @if (!Session.IsAuthenticated)
    {
        <div class="alert alert-warning text-center p-4">
            <h5><i class="bi bi-shield-lock me-2"></i> Helper Authentication Required</h5>
            <p class="text-muted">Please sign in with your Helper account to access duty mode and jobs.</p>
            <a href="login" class="btn btn-primary">Sign In</a>
        </div>
    }
    else
    {
        <!-- Helper Status Banner -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white p-3 rounded-circle fs-3 fw-bold">
                        <i class="bi bi-person-heart"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">Companion: @Session.FullName</h4>
                        <div class="d-flex align-items-center gap-2 small">
                            <span class="badge @(isOnDuty ? "bg-success" : "bg-secondary")">
                                Duty: @(isOnDuty ? "ON DUTY (Ready to Assist)" : "OFF DUTY")
                            </span>
                            <span class="badge @(locationSharing ? "bg-info text-dark" : "bg-dark")">
                                Location Sharing: @(locationSharing ? "Active" : "Private")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Toggles -->
                <div class="d-flex gap-3 align-items-center">
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" checked="@isOnDuty" @onchange="ToggleDuty" id="dutySwitch" />
                        <label class="form-check-label fs-6 fw-bold ms-1" for="dutySwitch">Duty Mode</label>
                    </div>

                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" checked="@locationSharing" @onchange="ToggleLocationSharing" id="privacySwitch" />
                        <label class="form-check-label fs-6 fw-bold ms-1" for="privacySwitch">GPS Sharing</label>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(statusFeedback))
            {
                <div class="alert alert-info py-2 small mt-3 mb-0">
                    <i class="bi bi-info-circle-fill me-1"></i> @statusFeedback
                </div>
            }
        </div>

        @if (activeJob != null)
        {
            <!-- Active Mission Controller -->
            <div class="card border-0 shadow-lg rounded-4 border-start border-primary border-4 p-4 mb-4 bg-white">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div>
                        <span class="badge bg-primary fs-6 px-3 py-1 rounded-pill">ACTIVE MISSION: @activeJob.Status</span>
                        <h4 class="fw-bold mt-2 mb-0">@activeJob.ServiceType</h4>
                        <p class="text-muted mb-0 small"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@activeJob.Address</p>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Patient / Requester:</div>
                        <div class="fw-bold">@activeJob.RequesterName</div>
                        @if (!string.IsNullOrEmpty(activeJob.RequesterPhone))
                        {
                            <a href="tel:@activeJob.RequesterPhone" class="btn btn-sm btn-outline-success mt-1">
                                <i class="bi bi-telephone-fill me-1"></i> Call @activeJob.RequesterPhone
                            </a>
                        }
                    </div>
                </div>

                <!-- Action Transition Buttons -->
                <div class="d-flex gap-2 flex-wrap mt-3 pt-3 border-top">
                    @if (activeJob.Status == "Accepted")
                    {
                        <button class="btn btn-primary px-4" @onclick='() => ChangeStatus("OnTheWay")'>
                            <i class="bi bi-bicycle me-1"></i> Start Moving (On The Way)
                        </button>
                    }
                    else if (activeJob.Status == "OnTheWay")
                    {
                        <button class="btn btn-success px-4" @onclick='() => ChangeStatus("Arrived")'>
                            <i class="bi bi-geo-fill me-1"></i> Mark Arrived (100m Geofence)
                        </button>
                    }
                    else if (activeJob.Status == "Arrived")
                    {
                        <button class="btn btn-info text-white px-4" @onclick='() => ChangeStatus("InProgress")'>
                            <i class="bi bi-play-circle-fill me-1"></i> Start Assistance (In Progress)
                        </button>
                    }
                    else if (activeJob.Status == "InProgress")
                    {
                        <button class="btn btn-danger px-4" @onclick="CompleteCurrentJob">
                            <i class="bi bi-stop-circle-fill me-1"></i> End Job & Compute Payout
                        </button>
                    }
                </div>
            </div>
        }

        <!-- Helper Jobs & History Tabs -->
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <button class="nav-link @(tab == "assigned" ? "active fw-bold" : "")" @onclick='() => tab = "assigned"'>
                    <i class="bi bi-clipboard-check me-1"></i> Assigned Missions (@assignedJobs.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(tab == "earnings" ? "active fw-bold" : "")" @onclick="LoadEarnings">
                    <i class="bi bi-wallet2 me-1"></i> My Payouts & Earnings (@earnings.Count)
                </button>
            </li>
        </ul>

        @if (tab == "assigned")
        {
            @if (!assignedJobs.Any())
            {
                <div class="text-center py-5 card border-0 shadow-sm rounded-4">
                    <div class="card-body">
                        <i class="bi bi-check-circle fs-1 text-muted"></i>
                        <h5 class="fw-bold mt-2">No Active Assigned Jobs</h5>
                        <p class="text-muted small">Turn Duty ON to be discovered by nearby users for hospital companion requests.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var job in assignedJobs)
                    {
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm rounded-4 p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-primary">@job.Status</span>
                                    <small class="text-muted">#@job.JobId</small>
                                </div>
                                <h5 class="fw-bold">@job.ServiceType</h5>
                                <p class="small text-muted mb-2"><i class="bi bi-geo-alt me-1 text-danger"></i>@job.Address</p>
                                <div class="small text-muted mb-3"><i class="bi bi-person me-1"></i>Patient: @job.RequesterName (@job.RequesterPhone)</div>

                                @if (job.Status != "Completed" && job.Status != "Cancelled")
                                {
                                    <button class="btn btn-outline-primary btn-sm w-100" @onclick="() => activeJob = job">
                                        Open Mission Controls
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (tab == "earnings")
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Job</th>
                                    <th>Service</th>
                                    <th>Working Time</th>
                                    <th>Amount Earned</th>
                                    <th>Payment Status</th>
                                    <th>Completed At</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in earnings)
                                {
                                    <tr>
                                        <td>#@item.JobId</td>
                                        <td class="fw-bold">@item.ServiceType</td>
                                        <td>@item.WorkingMinutes mins</td>
                                        <td class="fw-bold text-success fs-6">₹@item.Amount.ToString("N2")</td>
                                        <td>
                                            <span class="badge @(item.Status == "Paid" ? "bg-success" : "bg-warning text-dark")">
                                                @item.Status
                                            </span>
                                        </td>
                                        <td class="small text-muted">@(item.JobCompletedAt?.ToLocalTime().ToString("g") ?? "N/A")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private string tab = "assigned";
    private bool isOnDuty = false;
    private bool locationSharing = true;
    private string? statusFeedback;
    private JobResponseDto? activeJob;
    private List<JobResponseDto> assignedJobs = new();
    private List<HelperEarningsDto> earnings = new();

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated && Session.HelperId.HasValue)
        {
            await LoadHelperData();
        }
    }

    private async Task LoadHelperData()
    {
        if (!Session.HelperId.HasValue) return;

        try
        {
            var jobs = await JobService.GetJobsByHelperAsync(Session.HelperId.Value);
            assignedJobs = jobs.ToList();
            activeJob = assignedJobs.FirstOrDefault(j => j.Status is "Accepted" or "OnTheWay" or "Arrived" or "InProgress");
        }
        catch { }
    }

    private async Task ToggleDuty(ChangeEventArgs e)
    {
        if (!Session.HelperId.HasValue) return;
        isOnDuty = (bool)(e.Value ?? false);

        try
        {
            var res = await HelperService.SetDutyAsync(Session.HelperId.Value, isOnDuty);
            statusFeedback = $"Duty switched to {(isOnDuty ? "ON (Ready to receive requests)" : "OFF")}.";
        }
        catch (Exception ex)
        {
            isOnDuty = !isOnDuty;
            statusFeedback = $"Error: {ex.Message}";
        }
    }

    private async Task ToggleLocationSharing(ChangeEventArgs e)
    {
        if (!Session.HelperId.HasValue) return;
        locationSharing = (bool)(e.Value ?? false);

        try
        {
            var res = await HelperService.SetLocationSharingAsync(Session.HelperId.Value, locationSharing);
            statusFeedback = $"Location sharing privacy set to {(locationSharing ? "Enabled" : "Disabled")}.";
        }
        catch (Exception ex)
        {
            locationSharing = !locationSharing;
            statusFeedback = $"Error: {ex.Message}";
        }
    }

    private async Task ChangeStatus(string newStatus)
    {
        if (activeJob == null || !Session.HelperId.HasValue) return;

        try
        {
            var req = new UpdateJobStatusRequestDto
            {
                NewStatus = newStatus,
                // If marking Arrived, supply exact job coordinates for geofence check
                CurrentLat = activeJob.Lat,
                CurrentLng = activeJob.Lng
            };

            var updated = await JobService.UpdateJobStatusAsync(activeJob.JobId, Session.HelperId.Value, req);
            activeJob.Status = updated.Status;
            statusFeedback = $"Status updated to '{newStatus}'.";
            await LoadHelperData();
        }
        catch (Exception ex)
        {
            statusFeedback = $"Error: {ex.Message}";
        }
    }

    private async Task CompleteCurrentJob()
    {
        if (activeJob == null || !Session.HelperId.HasValue) return;

        try
        {
            var res = await JobService.CompleteJobAsync(activeJob.JobId, Session.HelperId.Value);
            statusFeedback = $"Mission completed! Payout calculated: ₹{res.Amount:N2} for {res.WorkingMinutes} mins.";
            activeJob = null;
            await LoadHelperData();
        }
        catch (Exception ex)
        {
            statusFeedback = $"Error: {ex.Message}";
        }
    }

    private async Task LoadEarnings()
    {
        tab = "earnings";
        if (!Session.HelperId.HasValue) return;

        try
        {
            var data = await PaymentRepo.GetByHelperAsync(Session.HelperId.Value);
            earnings = data.ToList();
        }
        catch { }
    }
}
