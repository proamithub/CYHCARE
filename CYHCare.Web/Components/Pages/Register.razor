@page "/register"
@rendermode InteractiveServer
@using CYHCare.Application.Common.Interfaces
@using CYHCare.Application.DTOs
@using CYHCare.Web.Services
@inject IAuthService AuthService
@inject UserSessionService Session
@inject NavigationManager Navigation

<PageTitle>Register — CYH Care</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-circle fs-1 text-primary"></i>
                        <h3 class="fw-bold mt-2">Create an Account</h3>
                        <p class="text-muted">Join CYH Care as a User or Helper</p>
                    </div>

                    <!-- Role Tabs -->
                    <ul class="nav nav-pills nav-fill mb-4 p-1 bg-light rounded" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link @(selectedRole == "User" ? "active" : "")" @onclick='() => SetRole("User")'>
                                <i class="bi bi-person me-1"></i> I Need Help (User)
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(selectedRole == "Helper" ? "active" : "")" @onclick='() => SetRole("Helper")'>
                                <i class="bi bi-heart-pulse me-1"></i> I Want to Help (Helper)
                            </button>
                        </li>
                    </ul>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success py-2 small mb-3">
                            <i class="bi bi-check-circle-fill me-1"></i> @successMessage
                        </div>
                    }

                    <EditForm Model="model" OnValidSubmit="HandleRegister">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Full Name</label>
                            <InputText class="form-control" placeholder="e.g. Ramesh Kumar" @bind-Value="model.FullName" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Phone Number</label>
                            <InputText class="form-control" placeholder="e.g. 9876543210" @bind-Value="model.Phone" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Email Address</label>
                            <InputText type="email" class="form-control" placeholder="name@example.com" @bind-Value="model.Email" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Password</label>
                            <InputText type="password" class="form-control" placeholder="Min. 6 characters" @bind-Value="model.Password" required />
                        </div>

                        @if (selectedRole == "Helper")
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Expected Hourly Rate (₹ / Hour)</label>
                                <InputNumber class="form-control" @bind-Value="model.HourlyRate" min="50" max="5000" />
                                <div class="form-text small">Default standard rate is ₹100/hr.</div>
                            </div>
                        }

                        <button type="submit" class="btn btn-primary w-100 py-2 mt-2 shadow-sm" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span> <span>Registering...</span>
                            }
                            else
                            {
                                <span>Create @selectedRole Account</span>
                            }
                        </button>
                    </EditForm>

                    <div class="text-center mt-4">
                        <span class="text-muted small">Already have an account? </span>
                        <a href="login" class="small fw-bold text-decoration-none">Sign In</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string selectedRole = "User";
    private UserRegisterRequestDto model = new() { Role = "User", HourlyRate = 100.00m };
    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting = false;

    private void SetRole(string role)
    {
        selectedRole = role;
        model.Role = role;
    }

    private async Task HandleRegister()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var res = await AuthService.RegisterAsync(model);
            Session.SetSession(res);

            successMessage = "Account registered successfully! Redirecting...";
            await Task.Delay(1000);

            if (res.Role == "Admin")
                Navigation.NavigateTo("/admin");
            else
                Navigation.NavigateTo("/user/dashboard");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
