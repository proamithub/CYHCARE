@page "/login"
@rendermode InteractiveServer
@using CYHCare.Application.Common.Interfaces
@using CYHCare.Application.DTOs
@using CYHCare.Web.Services
@inject IAuthService AuthService
@inject UserSessionService Session
@inject NavigationManager Navigation

<PageTitle>Sign In — CYH Care</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-box-arrow-in-right fs-1 text-primary"></i>
                        <h3 class="fw-bold mt-2">Welcome Back</h3>
                        <p class="text-muted">Sign in to your CYH Care account</p>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMessage
                        </div>
                    }

                    <EditForm Model="model" OnValidSubmit="HandleLogin">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Email Address</label>
                            <InputText type="email" class="form-control" placeholder="name@example.com" @bind-Value="model.Email" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Password</label>
                            <InputText type="password" class="form-control" placeholder="Enter your password" @bind-Value="model.Password" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 mt-2 shadow-sm" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span> <span>Signing In...</span>
                            }
                            else
                            {
                                <span>Sign In</span>
                            }
                        </button>
                    </EditForm>

                    <div class="card mt-4 bg-light border-0">
                        <div class="card-body p-3 small text-muted">
                            <span class="fw-bold text-dark">Demo Admin Account:</span><br />
                            Email: <code>admin@cyhcare.com</code><br />
                            Password: <code>Admin@123</code>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <span class="text-muted small">Don't have an account? </span>
                        <a href="register" class="small fw-bold text-decoration-none">Register Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private UserLoginRequestDto model = new();
    private string? errorMessage;
    private bool isSubmitting = false;

    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var res = await AuthService.LoginAsync(model);
            Session.SetSession(res);

            if (res.Role == "Admin")
                Navigation.NavigateTo("/admin");
            else
                Navigation.NavigateTo("/user/dashboard");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
