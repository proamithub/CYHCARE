@page "/how-it-works"
@layout Layout.PublicLayout

<PageTitle>How It Works — Hospital Companion Guide | CYH Care</PageTitle>

<HeadContent>
    <meta name="description" content="Learn how CYH Care connects families with compassionate, background-verified hospital companions in 4 simple steps. Real-time GPS geofencing & transparent hourly rates." />
    <meta property="og:title" content="How CYH Care Works — Hospital Companion Platform" />
    <meta property="og:description" content="Step-by-step guide to booking verified hospital companions for elderly parents and patients." />
    <link rel="canonical" href="https://cyhcare.com/how-it-works" />
</HeadContent>

<section class="container py-4 py-md-5" aria-labelledby="how-it-works-title">
    <div class="text-center col-lg-8 mx-auto mb-4 mb-md-5">
        <span class="badge badge-soft-primary px-3 py-2 rounded-pill text-uppercase fw-bold mb-2">Simple &amp; Trustworthy</span>
        <h1 id="how-it-works-title" class="display-5 fw-bold">How CYH Care Works</h1>
        <p class="lead text-muted">
            Connecting families with caring hospital companions in 4 easy, transparent steps.
        </p>
    </div>

    <!-- 4 Step Process Cards -->
    <div class="row g-4 mb-5">
        <div class="col-sm-6 col-lg-3">
            <article class="card h-100 border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="rounded-circle bg-primary-subtle text-primary mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <span class="fs-4 fw-bold">1</span>
                </div>
                <h2 class="h5 fw-bold">Post a Request</h2>
                <p class="text-muted small mb-0">
                    Tell us the patient's hospital name, appointment date, time, and special needs (wheelchair, OPD queues, medication pick-up).
                </p>
            </article>
        </div>

        <div class="col-sm-6 col-lg-3">
            <article class="card h-100 border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="rounded-circle bg-warning-subtle text-warning-emphasis mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <span class="fs-4 fw-bold">2</span>
                </div>
                <h2 class="h5 fw-bold">Helper Accepts</h2>
                <p class="text-muted small mb-0">
                    Verified companions within 10 km receive instant alerts. The first available verified helper accepts your mission.
                </p>
            </article>
        </div>

        <div class="col-sm-6 col-lg-3">
            <article class="card h-100 border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="rounded-circle bg-info-subtle text-info-emphasis mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <span class="fs-4 fw-bold">3</span>
                </div>
                <h2 class="h5 fw-bold">Live GPS &amp; Duty</h2>
                <p class="text-muted small mb-0">
                    Watch the helper arrive on the map (with 100m geofence). The helper assists the patient through doctor checkups, tests, and medicines.
                </p>
            </article>
        </div>

        <div class="col-sm-6 col-lg-3">
            <article class="card h-100 border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="rounded-circle bg-success-subtle text-success mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <span class="fs-4 fw-bold">4</span>
                </div>
                <h2 class="h5 fw-bold">Safe Return &amp; Payout</h2>
                <p class="text-muted small mb-0">
                    Once the patient is safely guided home or to their transport, the session completes. Fair hourly fees are calculated to the minute.
                </p>
            </article>
        </div>
    </div>

    <!-- Quick CTA banner -->
    <div class="p-4 p-md-5 bg-primary text-white rounded-4 text-center shadow">
        <h2 class="fw-bold mb-3">Ready to find a companion or become one?</h2>
        <p class="lead opacity-90 mb-4">Join thousands of families and verified companions helping each other every day.</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="user/dashboard" class="btn btn-warning btn-lg fw-bold rounded-pill px-4 text-dark w-100 w-sm-auto">
                <i class="bi bi-calendar-heart me-1"></i> Request a Companion
            </a>
            <a href="register?role=Helper" class="btn btn-outline-light btn-lg rounded-pill px-4 w-100 w-sm-auto">
                <i class="bi bi-person-badge me-1"></i> Register as a Helper
            </a>
        </div>
    </div>
</section>
