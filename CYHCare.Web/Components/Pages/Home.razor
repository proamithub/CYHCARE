@page "/"

<PageTitle>CYH Care — People Help People</PageTitle>

<div class="container py-4">
    <!-- Hero Section -->
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border text-center">
        <div class="container-fluid py-3">
            <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary mb-3">
                <i class="bi bi-heart-pulse-fill fs-1"></i>
            </div>
            <h1 class="display-5 fw-bold text-dark">CYH Care</h1>
            <p class="fs-4 text-muted">"People Help People" — Trusted Hospital & Local Assistance Platform</p>
            <p class="col-md-8 mx-auto fs-6 text-secondary mb-4">
                Need someone reliable to accompany your parents to a hospital appointment, help navigate queues, or assist with medicine pickups? 
                CYH Care connects you instantly with nearby verified, background-checked helpers with live GPS arrival tracking.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a href="register" class="btn btn-primary btn-lg px-4 gap-3 shadow-sm">
                    <i class="bi bi-person-plus-fill me-2"></i> Get Started
                </a>
                <a href="login" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                </a>
            </div>
        </div>
    </div>

    <!-- Feature Cards -->
    <div class="row row-cols-1 row-cols-md-3 g-4 py-3">
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center p-3">
                <div class="card-body">
                    <div class="text-primary mb-3 fs-2"><i class="bi bi-hospital"></i></div>
                    <h5 class="card-title fw-bold">Hospital Companion</h5>
                    <p class="card-text text-muted">Dedicated assistance for elderly checkups, OPD visits, reports collection, and wheelchair support.</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center p-3">
                <div class="card-body">
                    <div class="text-success mb-3 fs-2"><i class="bi bi-shield-check"></i></div>
                    <h5 class="card-title fw-bold">Verified Helpers</h5>
                    <p class="card-text text-muted">Every helper undergoes admin KYC verification before being approved to go on duty.</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center p-3">
                <div class="card-body">
                    <div class="text-danger mb-3 fs-2"><i class="bi bi-geo-alt-fill"></i></div>
                    <h5 class="card-title fw-bold">Live GPS & 100m Geofence</h5>
                    <p class="card-text text-muted">Real-time arrival tracking on OpenStreetMap with strict 100m geofence validation on arrival.</p>
                </div>
            </div>
        </div>
    </div>
</div>
