@page "/login"
@layout Layout.AuthLayout
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject UserSessionService Session
@inject NavigationManager Navigation

<PageTitle>Sign In — CYH Care</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <!-- Header Banner -->
            <div class="p-4 text-center bg-primary text-white position-relative" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%) !important;">
                <div class="mb-2">
                    <span class="badge bg-white text-primary rounded-pill px-3 py-1 fw-bold text-uppercase small shadow-sm">
                        <i class="bi bi-shield-lock-fill me-1"></i> Secure Access
                    </span>
                </div>
                <h3 class="fw-bold mb-1">Welcome Back</h3>
                <p class="text-white-50 small mb-0">Sign in to your CYH Care Portal</p>
            </div>

            <div class="card-body p-4 p-md-5">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2 small mb-4 d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-2 flex-shrink-0"></i>
                        <div>@errorMessage</div>
                    </div>
                }

                <EditForm Model="model" OnValidSubmit="HandleLogin">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">
                            <i class="bi bi-envelope-fill me-1 text-primary"></i> Email Address
                        </label>
                        <InputText type="email" class="form-control form-control-lg fs-6" placeholder="name@example.com" @bind-Value="model.Email" required />
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-bold text-secondary mb-0">
                                <i class="bi bi-key-fill me-1 text-primary"></i> Password
                            </label>
                        </div>
                        <InputText type="password" class="form-control form-control-lg fs-6" placeholder="••••••••" @bind-Value="model.Password" required />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 py-3 shadow-sm rounded-pill fw-bold" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span> <span>Verifying & Signing In...</span>
                        }
                        else
                        {
                            <span>Sign In to Portal <i class="bi bi-arrow-right ms-1"></i></span>
                        }
                    </button>
                </EditForm>

                <!-- 1-Click Fast Demo Login Buttons for Developer & Review -->
                <div class="mt-4 pt-3 border-top">
                    <div class="small fw-bold text-muted mb-2 text-center">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> 1-Click Instant Demo Login:
                    </div>
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary text-start d-flex justify-content-between align-items-center py-2" @onclick='() => FastLogin("user1@cyhcare.com", "User@123")'>
                            <span><i class="bi bi-person-heart me-2 text-primary"></i><strong>User / Patient:</strong> user1@cyhcare.com</span>
                            <span class="badge bg-primary-subtle text-primary">Patient Portal</span>
                        </button>

                        <button type="button" class="btn btn-sm btn-outline-success text-start d-flex justify-content-between align-items-center py-2" @onclick='() => FastLogin("helper1@cyhcare.com", "Helper@123")'>
                            <span><i class="bi bi-person-badge me-2 text-success"></i><strong>Helper / Companion:</strong> helper1@cyhcare.com</span>
                            <span class="badge bg-success-subtle text-success">Helper Portal</span>
                        </button>

                        <button type="button" class="btn btn-sm btn-outline-dark text-start d-flex justify-content-between align-items-center py-2" @onclick='() => FastLogin("admin@cyhcare.com", "Admin@123")'>
                            <span><i class="bi bi-shield-lock-fill me-2 text-warning"></i><strong>Admin:</strong> admin@cyhcare.com</span>
                            <span class="badge bg-dark text-white">Mission Control</span>
                        </button>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <span class="text-muted small">New to CYH Care? </span>
                    <a href="register" class="small fw-bold text-primary text-decoration-none">Create an Account</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private UserLoginRequestDto model = new();
    private string? errorMessage;
    private bool isSubmitting = false;

    private async Task FastLogin(string email, string password)
    {
        model.Email = email;
        model.Password = password;
        await HandleLogin();
    }

    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var res = await AuthService.LoginAsync(model);
            Session.SetSession(res);

            // Redirect to the respective area based on role
            if (res.Role == "Admin")
            {
                Navigation.NavigateTo("/admin");
            }
            else if (res.Role == "Helper")
            {
                Navigation.NavigateTo("/helper/dashboard");
            }
            else
            {
                Navigation.NavigateTo("/user/dashboard");
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
