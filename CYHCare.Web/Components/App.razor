<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <base href="/" />

    <!-- SEO Meta Tags -->
    <title>CYH Care — Hospital Companion & Patient Assistance Platform</title>
    <meta name="description" content="CYH Care connects elderly parents and patients with verified, compassionate local companions for hospital visits, OPD queues, wheelchair navigation, and live GPS tracking." />
    <meta name="keywords" content="hospital companion, elderly hospital assistance, patient escort, OPD visit companion, medical assistance, verified care helper, live GPS tracking, AIIMS companion, CYH Care" />
    <meta name="author" content="CYH Care" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://cyhcare.com/" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cyhcare.com/" />
    <meta property="og:site_name" content="CYH Care" />
    <meta property="og:title" content="CYH Care — No One Should Face the Hospital Alone" />
    <meta property="og:description" content="Compassionate, verified local companions for hospital visits, doctor consultations, and elderly patient assistance with 100m geofenced live GPS tracking." />
    <meta property="og:image" content="https://cyhcare.com/og-image.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="CYH Care — People Help People" />
    <meta name="twitter:description" content="Verified hospital companions for elderly parents and patients with real-time GPS arrival detection." />
    <meta name="twitter:image" content="https://cyhcare.com/og-image.svg" />

    <!-- Mobile & PWA Configuration -->
    <meta name="theme-color" content="#0284c7" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CYH Care" />
    <link rel="manifest" href="manifest.json" />

    <!-- Google Fonts & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Leaflet OpenStreetMap CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="CYHCare.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />

    <!-- Structured Data (Schema.org JSON-LD for Search Engines) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "EmergencyService",
      "name": "CYH Care",
      "alternateName": "People Help People",
      "url": "https://cyhcare.com",
      "logo": "https://cyhcare.com/favicon.png",
      "description": "On-demand verified hospital companion and patient assistance platform with live GPS geofencing and companion tracking.",
      "telephone": "+91-1800-294-2273",
      "contactPoint": {
        "@@type": "ContactPoint",
        "telephone": "+91-1800-294-2273",
        "contactType": "Customer Support",
        "areaServed": "IN",
        "availableLanguage": ["en", "hi"]
      },
      "serviceArea": {
        "@@type": "Country",
        "name": "India"
      },
      "priceRange": "₹100/hour",
      "openingHours": "Mo-Su 00:00-23:59"
    }
    </script>

    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <!-- Bootstrap 5 Bundle JS for Mobile Navigation & Modals -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Leaflet OpenStreetMap JS & Helper -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="js/leafletMap.js"></script>
</body>

</html>
